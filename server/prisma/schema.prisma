generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DoctorApproval {
  PENDING
  APPROVED
  REJECTED
}

enum TokenType {
  EMAIL_VERIFICATION
  PATIENT_ACTIVATION
  PASSWORD_RESET
}

enum DeviceStatus {
  REGISTERED
  ACTIVE
  DISABLED
}

enum SignalQuality {
  GOOD
  POOR
  NO_CONTACT
  SENSOR_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
  EMERGENCY
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum RecoveryStatus {
  NOT_EVALUATED
  ON_TRACK
  NEEDS_REVIEW
}

enum SummaryStatus {
  DRAFT
  APPROVED
  REJECTED
}

// ==========================================
// USER ACCOUNTS
// ==========================================

model User {
  id            String        @id @default(uuid())
  fullName      String
  email         String?       @unique
  phone         String?
  passwordHash  String?
  role          Role
  status        AccountStatus @default(PENDING)
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  doctor             Doctor?
  patient            Patient?
  sessions           Session[]
  tokens             AccountToken[]
  acknowledgedAlerts Alert[]

  @@index([role, status])
}

// ==========================================
// DOCTOR PROFILES
// ==========================================

model Doctor {
  id                 String         @id @default(uuid())
  userId             String         @unique
  specialization     String
  registrationNumber String         @unique
  qualification      String
  hospital           String?
  approval           DoctorApproval @default(PENDING)
  approvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  patients        Patient[]
  recoveryPlans   RecoveryPlan[]
  medications     Medication[]
  healthSummaries HealthSummary[]
}

// ==========================================
// PATIENT PROFILES
// ==========================================

model Patient {
  id                  String    @id @default(uuid())
  patientCode         String    @unique
  userId              String    @unique
  doctorId            String
  dateOfBirth         DateTime?
  gender              String?
  bloodGroup          String?
  medicalNotes        String?
  monitoringConsentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  emergencyContacts EmergencyContact[]
  assignments       DeviceAssignment[]
  readings          VitalReading[]
  recoveryPlans     RecoveryPlan[]
  medications       Medication[]
  alerts            Alert[]
  notifications     Notification[]
  healthSummaries   HealthSummary[]

  @@index([doctorId])
}

// ==========================================
// AUTHENTICATION
// ==========================================

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ==========================================
// EMERGENCY CONTACTS
// ==========================================

model EmergencyContact {
  id           String    @id @default(uuid())
  patientId    String
  fullName     String
  relationship String
  phone        String?
  email        String?
  isPrimary    Boolean   @default(false)
  consentAt    DateTime?
  createdAt    DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

// ==========================================
// ESP32 DEVICES
// ==========================================

model Device {
  id              String       @id @default(uuid())
  deviceCode      String       @unique
  deviceName      String
  apiKeyHash      String       @unique
  status          DeviceStatus @default(REGISTERED)
  firmwareVersion String?
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments DeviceAssignment[]

  @@index([status])
}

model DeviceAssignment {
  id           String    @id @default(uuid())
  deviceId     String
  patientId    String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  device   Device         @relation(fields: [deviceId], references: [id])
  patient  Patient        @relation(fields: [patientId], references: [id])
  readings VitalReading[]

  @@index([deviceId, unassignedAt])
  @@index([patientId, unassignedAt])
}

// ==========================================
// REAL SENSOR READINGS
// ==========================================

model VitalReading {
  id           String @id @default(uuid())
  patientId    String
  assignmentId String
  readingKey   String @unique

  heartRate   Float?
  spo2        Float?
  temperature Float?

  heartRateMin   Float?
  heartRateMax   Float?
  spo2Min        Float?
  spo2Max        Float?
  temperatureMin Float?
  temperatureMax Float?

  signalQuality SignalQuality
  sampleCount   Int           @default(1)
  isAggregated  Boolean       @default(false)

  recordedAt DateTime
  receivedAt DateTime @default(now())

  patient    Patient          @relation(fields: [patientId], references: [id])
  assignment DeviceAssignment @relation(fields: [assignmentId], references: [id])
  alerts     Alert[]

  @@index([patientId, recordedAt])
  @@index([assignmentId, recordedAt])
}

// ==========================================
// RECOVERY TRACKING
// ==========================================

model RecoveryPlan {
  id          String  @id @default(uuid())
  patientId   String
  doctorId    String
  title       String
  description String?

  heartRateMin   Float?
  heartRateMax   Float?
  spo2Min        Float?
  spo2Max        Float?
  temperatureMin Float?
  temperatureMax Float?

  expectedOutcome String?
  clinicalNotes   String?
  status          RecoveryStatus @default(NOT_EVALUATED)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId, isActive])
}

// ==========================================
// MEDICATION MANAGEMENT
// ==========================================

model Medication {
  id           String    @id @default(uuid())
  patientId    String
  doctorId     String
  medicineName String
  dosage       String
  frequency    String
  instructions String?
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient Patient         @relation(fields: [patientId], references: [id])
  doctor  Doctor          @relation(fields: [doctorId], references: [id])
  logs    MedicationLog[]

  @@index([patientId, isActive])
}

model MedicationLog {
  id            String    @id @default(uuid())
  medicationId  String
  scheduledAt   DateTime?
  takenAt       DateTime?
  taken         Boolean
  responseNotes String?
  sideEffects   String?
  createdAt     DateTime  @default(now())

  medication Medication @relation(fields: [medicationId], references: [id])

  @@index([medicationId, createdAt])
}

// ==========================================
// ALERTS AND EMERGENCIES
// ==========================================

model Alert {
  id        String        @id @default(uuid())
  patientId String
  readingId String?
  title     String
  message   String
  source    String
  severity  AlertSeverity
  status    AlertStatus   @default(OPEN)

  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolutionNotes  String?

  createdAt DateTime @default(now())

  patient        Patient        @relation(fields: [patientId], references: [id])
  reading        VitalReading?  @relation(fields: [readingId], references: [id])
  acknowledgedBy User?          @relation(fields: [acknowledgedById], references: [id])
  notifications  Notification[]

  @@index([patientId, createdAt])
  @@index([status, severity])
}

// ==========================================
// REAL EMAIL AND SMS NOTIFICATIONS
// ==========================================

model Notification {
  id                String              @id @default(uuid())
  patientId         String?
  alertId           String?
  channel           NotificationChannel
  recipient         String
  subject           String?
  message           String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                 @default(0)
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  patient Patient? @relation(fields: [patientId], references: [id])
  alert   Alert?   @relation(fields: [alertId], references: [id])

  @@index([status, createdAt])
  @@index([patientId, createdAt])
}

// ==========================================
// AI HEALTH SUMMARIES
// ==========================================

model HealthSummary {
  id          String        @id @default(uuid())
  patientId   String
  doctorId    String
  periodStart DateTime
  periodEnd   DateTime
  content     String
  aiModel     String?
  status      SummaryStatus @default(DRAFT)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId, createdAt])
}
